  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "test": "docker compose exec api sh -c \"NODE_ENV=test npx dotenv -e .env.test -- vitest run\"",
    "test:integration": "docker compose exec api sh -c \"NODE_ENV=test npx dotenv -e .env.test -- vitest run tests/integration\"",
    "db:migrate": "docker compose exec api npx prisma migrate dev",
    "db:generate": "docker compose exec api npx prisma generate",
    "db:deploy": "docker compose exec api npx prisma migrate deploy",
    "db:studio": "docker compose exec api npx prisma studio",
    "db:seed": "docker compose exec api npx tsx src/config/scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
